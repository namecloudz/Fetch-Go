{
  "name": "fetch-go",
  "version": "1.1.3",
  "description": "Lightweight Axios-compatible HTTP client built on native fetch(). ~2KB gzipped.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "size": "npm run build && echo '--- Bundle sizes ---' && ls -lh dist/index.js dist/index.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "fetch",
    "http",
    "client",
    "axios",
    "request",
    "ajax",
    "lightweight",
    "wrapper",
    "typescript",
    "promise",
    "async",
    "interceptor",
    "retry",
    "timeout",
    "cancel"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/user/fetch-go"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "sideEffects": false
}
